<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="easloc_card_view_list" model="ir.ui.view">
        <field name="name">easloc.card.list</field>
        <field name="model">easloc.card</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('erased', 'cancelled')" decoration-danger="state == 'error'">
                <field name="name"/>
                <field name="room_id"/>
                <field name="partner_id" string="Client"/>
                <field name="begin_date"/>
                <field name="end_date"/>
                <field name="card_no" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'active'"
                       decoration-danger="state == 'error'" decoration-info="state == 'draft'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="easloc_card_view_form" model="ir.ui.view">
        <field name="name">easloc.card.form</field>
        <field name="model">easloc.card</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_encode" type="object" string="Encoder la carte"
                            class="btn-primary" invisible="state not in ('draft', 'error')"
                            help="Posez une carte vierge (ou à réutiliser) sur l'encodeur avant de cliquer."/>
                    <button name="action_make_copy" type="object" string="Carte supplémentaire"
                            invisible="state != 'active'"/>
                    <button name="action_erase" type="object" string="Départ : effacer la carte"
                            class="btn-primary" invisible="state != 'active'"
                            help="Posez la carte rendue par le client sur l'encodeur avant de cliquer."/>
                    <button name="action_mark_lost" type="object" string="Carte non rendue"
                            invisible="state != 'active'"
                            confirm="La carte restera valable jusqu'à sa date de fin. Continuer ?"/>
                    <button name="action_cancel" type="object" string="Annuler"
                            invisible="state not in ('draft', 'error')"/>
                    <button name="action_reset_draft" type="object" string="Remettre en brouillon"
                            invisible="state not in ('cancelled', 'error')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,erased"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoices" type="object" class="oe_stat_button"
                                icon="fa-pencil-square-o" invisible="invoice_count == 0">
                            <field name="invoice_count" widget="statinfo" string="Factures client"/>
                        </button>
                        <button name="action_create_invoice" type="object" class="oe_stat_button"
                                icon="fa-file-text-o" string="Créer la facture"
                                invisible="state != 'active' or invoice_count != 0 or parent_id"/>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="state != 'error' or not last_error">
                        <field name="last_error"/>
                    </div>
                    <div class="alert alert-info" role="status" invisible="state != 'draft'">
                        Posez la carte sur l'encodeur, puis cliquez sur « Encoder la carte ».
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Séjour">
                            <field name="room_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="lock_no"/>
                            <field name="partner_id" string="Client" required="state in ('draft', 'error')"
                                   readonly="state not in ('draft', 'error')"/>
                            <field name="cni" readonly="1" invisible="not partner_id"/>
                            <field name="begin_date" readonly="state not in ('draft', 'error') or parent_id"/>
                            <field name="end_date" readonly="state not in ('draft', 'error')"/>
                        </group>
                        <group string="Carte">
                            <field name="encoder_id" readonly="state not in ('draft', 'error')" options="{'no_create': True}"/>
                            <field name="card_no" readonly="state not in ('draft', 'error')"/>
                            <field name="llock" readonly="state not in ('draft', 'error')"/>
                            <field name="pdoors" readonly="state not in ('draft', 'error')"/>
                            <field name="parent_id" invisible="not parent_id"/>
                            <field name="issued_date" invisible="not issued_date"/>
                            <field name="erased_date" invisible="not erased_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Produits et services à facturer" invisible="parent_id">
                        <field name="line_ids" readonly="state not in ('draft', 'error')">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="product_id" options="{'no_create': True}"/>
                                <field name="name"/>
                                <field name="quantity" string="Heures"
                                       help="Nombre d'heures facturées. Configurez l'unité de mesure du produit en heures."/>
                                <field name="price_unit"/>
                                <field name="subtotal" sum="Total"/>
                                <field name="currency_id" column_invisible="True"/>
                            </list>
                        </field>
                    </group>
                    <notebook>
                        <page string="Copies" name="copies" invisible="not copy_ids">
                            <field name="copy_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="card_no"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Opérations encodeur" name="jobs" groups="base.group_system">
                            <field name="job_ids" readonly="1">
                                <list>
                                    <field name="create_date"/>
                                    <field name="job_type"/>
                                    <field name="state"/>
                                    <field name="error"/>
                                </list>
                            </field>
                            <group>
                                <field name="card_data"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="easloc_card_view_search" model="ir.ui.view">
        <field name="name">easloc.card.search</field>
        <field name="model">easloc.card</field>
        <field name="arch" type="xml">
            <search>
                <field name="guest_name"/>
                <field name="room_id"/>
                <field name="name"/>
                <filter name="active_cards" string="Actives" domain="[('state', '=', 'active')]"/>
                <filter name="draft" string="Brouillons" domain="[('state', '=', 'draft')]"/>
                <filter name="error" string="En erreur" domain="[('state', '=', 'error')]"/>
                <separator/>
                <filter name="departures_today" string="Départs aujourd'hui"
                        domain="[('state', '=', 'active'), ('end_date', '&lt;', (context_today() + relativedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_room" string="Chambre" context="{'group_by': 'room_id'}"/>
                    <filter name="group_state" string="État" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="easloc_card_action" model="ir.actions.act_window">
        <field name="name">Cartes client</field>
        <field name="res_model">easloc.card</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active_cards': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Émettez une carte client</p>
            <p>Choisissez la chambre, le client et la date de départ, posez la carte sur
               l'encodeur et cliquez sur « Encoder la carte ».</p>
        </field>
    </record>
</odoo>
